# Ported from alacritty/.config/alacritty/alacritty.toml

# --- font ---
font-family = MesloLGM Nerd Font
font-size = 12

# --- colors ---
background = #1E1D2F
foreground = #D9E0EE
bold-color = bright

palette = 0=#6E6C7E
palette = 1=#F28FAD
palette = 2=#ABE9B3
palette = 3=#FAE3B0
palette = 4=#96CDFB
palette = 5=#F5C2E7
palette = 6=#89DCEB
palette = 7=#D9E0EE
palette = 8=#988BA2
palette = 9=#F28FAD
palette = 10=#ABE9B3
palette = 11=#FAE3B0
palette = 12=#96CDFB
palette = 13=#F5C2E7
palette = 14=#89DCEB
palette = 15=#D9E0EE
palette = 16=#F8BD96
palette = 17=#F5E0DC

# --- cursor ---
cursor-style = block
cursor-style-blink = false
cursor-color = #F5E0DC
cursor-text = #1E1D2F

# --- window ---
window-decoration = true
window-padding-x = 10
window-padding-y = 12
window-width = 80
window-height = 20
background-opacity = 0.5

# --- mouse / selection ---
mouse-hide-while-typing = true
selection-word-chars = ,│`|:"' ()[]{}<>

# --- shell ---
command = /usr/bin/zsh

# --- keybinds ---
keybind = shift+enter=text:\x1b\r
