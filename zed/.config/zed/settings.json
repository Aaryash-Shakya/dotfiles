{
  "agent": {
    "default_model": {
      "enable_thinking": false,
      "model": "deepseek-coder-v2:16b",
      "provider": "ollama"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_size": 12,
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "confirm_quit": true,
  "context_servers": {
    "lean-ctx": {
      "args": [],
      "command": "/home/aaryash/.local/bin/lean-ctx",
      "env": {}
    },
    "postgres-context-server": {
      "settings": {
        "database_url": "postgresql://aaryash-f:(password)@localhost:5432/(dbname)"
      }
    }
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "mode": "eager"
  },
  "formatter": "auto",
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "dark": "Catppuccin Latte",
    "light": "Catppuccin Latte",
    "mode": "light"
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "languages": {
    "CSS": {
      "formatter": "prettier"
    },
    "HTML": {
      "formatter": "prettier"
    },
    "JSON": {
      "formatter": "prettier"
    },
    "JSONC": {
      "formatter": "prettier"
    },
    "JavaScript": {
      "formatter": "prettier"
    },
    "Markdown": {
      "formatter": "prettier"
    },
    "TSX": {
      "formatter": "prettier"
    },
    "TypeScript": {
      "formatter": "prettier"
    },
    "YAML": {
      "formatter": "prettier"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "restore_on_startup": "last_session",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Tokyo Night Light",
    "mode": "dark"
  },
  "ui_font_size": 12
}